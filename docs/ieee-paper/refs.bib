@article{siriwardanaPotentialAirsideEconomizers2013,
  title = {Potential of Air-Side Economizers for Data Center Cooling: {{A}} Case Study for Key {{Australian}} Cities},
  shorttitle = {Potential of Air-Side Economizers for Data Center Cooling},
  author = {Siriwardana, Jayantha and Jayasekara, Saliya and Halgamuge, Saman K.},
  year = 2013,
  month = apr,
  journal = {Applied Energy},
  volume = {104},
  pages = {207--219},
  issn = {03062619},
  doi = {10.1016/j.apenergy.2012.10.046},
  urldate = {2026-05-26},
  abstract = {The provision of low cost cooling is challenging due to high energy costs and increasing heat dissipation volumes from data centers. In Australia, with the introduction of emissions trading scheme, the cost of energy with carbon origin is expected to increase. In order to reduce cooling costs, alternative low cost cooling methods for data centers are highly sought after. In this study, we investigated using air-side economizers to introduce outside air with desired supply air conditions, by exploiting the cool and dry Australian climate conditions. Our approach was based on analyzing the hourly temperature and humidity data gathered over past 12 years for 20 weather monitoring stations across Australia representing all geographical regions and determining the potential of using air-side economizers for those locations. As the result, we demonstrated that there is a sizable potential for using air-side economizers in some states that could lead to significant savings on cooling costs to data center operators.},
  langid = {english},
  keywords = {notion},
  file = {/home/gonz4/Zotero/storage/VT8AEWZJ/Siriwardana et al. - 2013 - Potential of air-side economizers for data center cooling A case study for key Australian cities.pdf}
}

@inproceedings{yangClimaticApplicabilityIndirect2023,
  title = {Climatic Applicability of Indirect Evaporative Cooling Technology for Data Centers in {{China}}},
  booktitle = {Building {{Simulation}} 2023},
  author = {Yang, Chuanjun and Sun, Le and Yan, Weichao and Wang, Xinyu and Cui, Xin},
  year = 2023,
  series = {Building {{Simulation}}},
  volume = {18},
  pages = {3278--3283},
  publisher = {IBPSA},
  doi = {10.26868/25222708.2023.1340},
  urldate = {2026-05-26},
  abstract = {Indirect evaporative cooling is widely utilized in data centers for its energy-saving benefits. Nonetheless, Few compare it to free cooling's climatic applicability. This article presents a case study of Xi'an on indirect evaporative cooling in data centers. Statistical analysis of Xi'an's outdoor temperature data calculates the percentage of annual hours of different operating modes of the indirect evaporative cooling system. Using meteorological data to study the climatic applicability of free cooling and indirect evaporative cooling. The results show that the application of complete free cooling based on the indirect evaporative cooling system reduces the usage time of mechanical cooling, significantly decreasing data center energy consumption. Indirect evaporative cooling has wider applicability than free cooling in China. Additionally, in the tropical monsoon climate of southern China, a combination of indirect evaporative cooling and mechanical cooling allows for maximum energy savings. This study informs the promotion of indirect evaporative cooling in Chinese data centers.},
  langid = {american},
  keywords = {notion},
  file = {/home/gonz4/Zotero/storage/46AK4A2I/Yang et al. - 2023 - Climatic applicability of indirect evaporative cooling technology for data centers in China.pdf}
}
